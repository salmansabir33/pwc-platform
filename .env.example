# Development only. Copy to .env and replace placeholders; never use production secrets.
# Compose loads .env; native Django requires explicit shell export (see setup runbook).
DJANGO_SECRET_KEY=replace-with-strong-local-development-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DB_NAME=pwc
DB_USER=pwc
DB_PASSWORD=replace-with-strong-local-db-password
# Use 127.0.0.1 instead when running Django outside Compose.
DB_HOST=db
DB_PORT=5432

# PWC-03A.2 synthetic auth is disabled by default. See its runbook for isolated
# key generation/rotation and the separate production/real-user approval gates.
PWC_AUTH_FLOWS_ENABLED=0
PWC_AUTH_ABUSE_KEY=
PWC_AUTH_DELIVERY_ACTIVE_KEY=
PWC_AUTH_DELIVERY_KEYS={}
PWC_AUTH_LINK_ORIGIN=https://pwc.invalid

# PWC-03A.3 synthetic browser/mobile sessions are separately disabled.
# Portal map is exact HTTPS origins; empty means no browser issuance.
# Generate a separate external >=256-bit key; never reuse the placeholders.
PWC_AUTH_SESSIONS_ENABLED=0
PWC_AUTH_SESSION_KEY=
PWC_AUTH_PORTALS={}

# PWC-03A.4 MFA/assurance stays separately disabled, synthetic-only.
# Independent external Fernet encryption key ring, active ID and HMAC proof key.
PWC_AUTH_MFA_ENABLED=0
PWC_AUTH_MFA_ACTIVE_KEY=
PWC_AUTH_MFA_KEYS={}
PWC_AUTH_MFA_PROOF_KEY=
