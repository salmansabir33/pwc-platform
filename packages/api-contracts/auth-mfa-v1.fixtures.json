{
  "version": "v1",
  "scope": "PWC-03A.4 synthetic; no usable credentials, domain grants or assisted recovery",
  "prefix": "/api/v1/auth/",
  "preauth_status": 202,
  "preauth_keys": ["status", "challenge_id", "preauth_control", "expires_in"],
  "enrollment_keys": ["enrollment_id", "secret", "otpauth_uri", "expires_at"],
  "activation_keys": ["status", "recovery_codes"],
  "intent_keys": ["intent_id", "expires_at", "required_methods"],
  "step_up_keys": ["assurance_proof", "expires_at"],
  "factor_status_keys": ["enabled", "pending", "recovery_hold_state"],
  "intent_request": {"operation": "mfa.enroll", "context": {"kind": "personal", "id": "<own-user-uuid>"}, "command": {}},
  "step_up_request": {"intent_id": "<server-intent-uuid-nonce>", "password": "<current-password>", "totp_code": "<optional-fresh-six-digit-code>"},
  "mfa_confirm_request": {"challenge_id": "<challenge-uuid>", "preauth_control": "<initiating-client-control>", "method": "totp", "code": "<six-digit-code>"},
  "methods": ["totp", "recovery_code"],
  "personal_operations": ["mfa.enroll", "mfa.remove", "mfa.recovery_codes.rotate", "sessions.logout_all", "sessions.revoke", "recovery_hold.clear"],
  "revoke_command": {"session_id": "<own-target-session-uuid>"},
  "other_commands": {},
  "recovery_code_count": 10,
  "maximum_lifetime_seconds": 300,
  "totp": {"digits": 6, "interval_seconds": 30, "skew_steps": 1, "algorithm": "SHA1"},
  "lost_response": "Never fetch prior secrets/proofs/codes. Start new preauth, intent or authorized enrollment/rotation. Re-login after uncertain session issuance; no refresh replay grace.",
  "ordinary_responses_never_include": ["secret", "otpauth_uri", "recovery_codes", "code_digest", "encrypted_secret", "assurance_proof"],
  "domain_scope": "Unmapped/nonpersonal operations always deny; no NGO financial acceptance is claimed"
}
